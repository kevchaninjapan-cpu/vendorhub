{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],

    "allowJs": false,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",

    // ✅ THIS IS THE IMPORTANT BIT
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"]
    },

    "incremental": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "plugins": [
      { "name": "next" }
    ],

    "types": ["vitest/globals", "node"]
  },

  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],

"exclude": [
  "node_modules",
  "src/app/_admin_legacy/**",
  "src/app/api/_admin_legacy/**",
  "src/app/_onboarding_legacy/**",
  "src/app/_verification_legacy/**",
  "src/app/api/_docs_legacy/**",
  "src/app/api/_onboarding_legacy/**",
  "src/app/api/_verification_legacy/**",
  "src/app/api/_listings_legacy/**"
]
}
